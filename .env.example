# Copy this file to .env.local and fill in your Firebase project's web app config
# (Firebase console → Project settings → General → Your apps → SDK setup and configuration).
#
# If these are left unset, My Assistant runs entirely offline with data stored
# only in this browser's local storage — Firebase is optional.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
