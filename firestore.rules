rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user (including anonymous sessions) can only read
    // and write their own data, scoped under users/{their uid}.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
